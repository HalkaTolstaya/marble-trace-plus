{
  "identifier": "io.github.halkatolstaya.marble-trace-plus.dev",
  "app": {
    "security": {
      "csp": {
        "script-src": ["'self'", "'unsafe-inline'"]
      },
      "dangerousDisableAssetCspModification": true,
      "capabilities": [
        "main",
        "overlay",
        {
          "identifier": "dev-mcp-bridge",
          "description": "Dev builds only (--features dev): lets a coding agent drive the app through the Tauri MCP bridge. Never in release.",
          "windows": ["main", "overlay-*", "diagnostics-hud"],
          "permissions": ["mcp-bridge:default"]
        }
      ]
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "npm run build -- --mode devtools"
  }
}
